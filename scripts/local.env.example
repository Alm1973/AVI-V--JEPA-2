# Copy to scripts/local.env (gitignored) and fill in. Read by common.sh and
# by the Python scripts (msi_host.py).
MSI_MAC="XX:XX:XX:XX:XX:XX"          # the MSI's Ethernet MAC, for Wake-on-LAN
MSI_TS_IP="100.x.y.z"                # the MSI's Tailscale IPv4
MSI_HTTP="http://msi.your-tailnet.ts.net:8000"   # MagicDNS name of the dashboard
MSI_PROFILE='C:\Users\YOUR-WINDOWS-USER'
