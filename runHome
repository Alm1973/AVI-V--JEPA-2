#!/usr/bin/env bash
# runHome - bring AVI up and hand back a remote controller.
#
#   runHome              20 minutes, simulator (the arm does not move)
#   runHome 45           45 minutes
#   runHome live         MOVES THE REAL ARM; asks for confirmation first
#   runHome stop         end the session and free the camera
#   runHome status
#
# Everything it needs it does: wakes the MSI if it is reachable, bounds the
# keep-awake so the laptop cannot be left running, deploys the current code
# from this Mac, takes the camera off whatever had it, and prints the URL.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

ARG="${1:-}"
case "$ARG" in
  stop)    exec ./scripts/teleop.sh stop ;;
  status)  exec ./scripts/teleop.sh status ;;
  logs)    shift; exec ./scripts/teleop.sh logs "$@" ;;
  live)    MODE=live;  MINUTES="${2:-20}" ;;
  ''|*[!0-9]*) MODE=start; MINUTES=20 ;;
  *)       MODE=start; MINUTES="$ARG" ;;
esac

echo "deploying the current code ..."
./scripts/deploy.sh >/dev/null 2>&1 || {
  echo "deploy failed. Is the MSI reachable?  ./scripts/wake-timers.sh status" >&2
  exit 1; }

./scripts/teleop.sh "$MODE" "$MINUTES" || exit 1

URL="http://msi:${AVI_TELEOP_PORT:-8081}/"
command -v open >/dev/null && open "$URL" 2>/dev/null || true
